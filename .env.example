# Huashuo LLM settings. Copy this file to `.env` in the directory you run `huashuo` from
# (or to ~/.config/huashuo/env for every directory), then fill in one of the setups below.
# `.env` is git-ignored; variables already set in the environment win over the file.
#
# The LLM finds who says each line of dialogue (multi-voice reading). Without any of
# this, `huashuo --single-voice` has the narrator read the whole book and needs no LLM.

# --- Setup 1: a cloud LLM (the default, best quality) ---------------------------------
# Any OpenAI-compatible service. With OpenAI itself only the key is needed: create one at
# https://platform.openai.com/api-keys (a project key with access to the Chat Completions
# API is enough). OPENAI_API_KEY is used too if HUASHUO_LLM_API_KEY is not set.
HUASHUO_LLM_API_KEY=

# The model; default gpt-6-sol. gpt-6-luna is about 20 times cheaper but mistakes more
# speakers in back-and-forth dialogue without speech tags. Same as --llm-model.
# HUASHUO_LLM_MODEL=gpt-6-sol

# Another provider's OpenAI-compatible endpoint; default https://api.openai.com/v1.
# Same as --llm-base-url. The model must support JSON Schema structured output.
# HUASHUO_LLM_BASE_URL=https://example.com/v1

# USD per million tokens (input, output), needed only for a model Huashuo does not know
# the price of, so the --max-llm-cost cap can be enforced.
# HUASHUO_LLM_PRICE_IN=2.00
# HUASHUO_LLM_PRICE_OUT=10.00

# --- Setup 2: a local LLM (free; the book's text stays on your Mac) ---------------------
# Point the endpoint at LM Studio, Ollama or llama-server; no key is needed and the cost
# is zero. Name the model you loaded there.
# HUASHUO_LLM_BASE_URL=http://localhost:1234/v1     # LM Studio; Ollama: http://localhost:11434/v1
# HUASHUO_LLM_MODEL=the-model-name-your-server-shows

# --- Optional, either setup -------------------------------------------------------------
# Speaker-attribution calls in flight at once; default 6. Same as --llm-concurrency.
# Lower it for a local model or a provider with tight rate limits.
# HUASHUO_LLM_CONCURRENCY=6
